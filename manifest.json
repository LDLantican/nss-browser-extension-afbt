{
  "manifest_version": 3,
  "name": "NSS Appfolio Helper",
  "version": "2.6.1",
  "description": "Sync Appfolio work orders to the ASH web app, deliver approved invoices back to the Appfolio vendor portal, and import them into Buildertrend.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["storage", "tabs", "alarms", "notifications"],
  "optional_host_permissions": ["*://*/*"],
  "action": {
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    },
    "default_popup": "ui/popup.html"
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.appfolio.com/maintenance/service_requests/work_orders*"
      ],
      "js": ["content/appfolio_scrape.js", "content/appfolio_list.js"],
      "css": ["content/appfolio.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.appfolio.com/maintenance/service_requests/*/work_orders/*"
      ],
      "js": ["content/appfolio_scrape.js", "content/appfolio_work_order.js"],
      "css": ["content/appfolio.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://vendor.appfolio.com/*"],
      "js": ["content/appfolio_vendor_invoice.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://buildertrend.net/app/JobPage/0/*"],
      "js": ["content/buildertrend_add_job.js"],
      "css": ["content/buildertrend_add_job.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://buildertrend.net/app/Landing*"],
      "js": ["content/buildertrend_landing.js"],
      "run_at": "document_idle"
    }
  ]
}
