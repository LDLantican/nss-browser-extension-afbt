{
  "manifest_version": 3,
  "name": "NSS Appfolio Helper",
  "version": "4.1.7",
  "description": "Import AppFolio work orders into the ASH web app, bill approved work back in the AppFolio vendor portal, and put approved inspections into the property manager's AppFolio, as an ASH delivery worker.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["storage", "tabs", "tabGroups", "alarms", "notifications"],
  "optional_host_permissions": [
    "https://alabamasignaturehomes.com/*",
    "https://*.alabamasignaturehomes.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    },
    "default_popup": "ui/popup.html"
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.appfolio.com/maintenance/service_requests/work_orders*"
      ],
      "js": ["content/appfolio_scrape.js", "content/appfolio_list.js"],
      "css": ["content/appfolio.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.appfolio.com/maintenance/service_requests/*/work_orders/*"
      ],
      "js": ["content/appfolio_scrape.js", "content/appfolio_work_order.js"],
      "css": ["content/appfolio.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://vendor.appfolio.com/*"],
      "js": ["adapters/appfolio_vendor/selectors.v1.js", "adapters/appfolio_vendor/page.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.appfolio.com/inspections/*",
        "https://*.appfolio.com/maintenance/inspections*"
      ],
      "exclude_matches": ["https://vendor.appfolio.com/*"],
      "js": ["adapters/appfolio_pm/selectors.v1.js", "adapters/appfolio_pm/page.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.appfolio.com/maintenance/inspections*"],
      "exclude_matches": ["https://vendor.appfolio.com/*"],
      "js": ["adapters/appfolio_pm/page_bridge.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
